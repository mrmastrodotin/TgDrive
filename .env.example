# 1. Create bot(s) via @BotFather on Telegram and copy HTTP API token(s).
# For multiple bots (load balancing / parallel transfers), use TG_BOT_TOKENS separated by commas:
# TG_BOT_TOKENS=token1,token2,token3
TG_BOT_TOKEN=your_telegram_bot_token_here

# 2. Create private Telegram channel, add your bot as Administrator with "Post Messages" permission.
# Forward a message from channel to @userinfobot or @username_to_id_bot to get the numeric channel ID (starts with -100):
TG_CHANNEL_ID=-1001234567890

# Security & Encryption
# Master secret used for deriving AES-256-GCM encryption keys per file chunk:
ENCRYPTION_SECRET=generate_a_strong_random_secret_here_min_32_chars
# Dedicated secret for authenticated AES-256-GCM encryption of stored Telegram bot tokens at rest (defaults to ENCRYPTION_SECRET if omitted):
BOT_CREDENTIAL_SECRET=dedicated_secret_for_bot_credentials_at_rest_min_32_chars
# Dedicated JWT signing secret (defaults to first 32 bytes of ENCRYPTION_SECRET if omitted):
JWT_SECRET=dedicated_secret_for_signing_jwt_tokens_min_32_chars

# Web Dashboard Password
ADMIN_PASSWORD=change_this_secure_admin_password

# Database Settings
# For production durability, use Turso cloud database:
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token
DATABASE_PATH=tgdrive.db

# Server Settings
PORT=8080
ALLOWED_ORIGIN=http://localhost:3000

# Chunking & Memory Budget (standardized environment variables)
# CHUNK_SIZE: Plaintext chunk size in bytes (16 MiB default: 16777216)
CHUNK_SIZE=16777216
# CACHE_MAX_BYTES: Decrypted chunk LRU cache memory budget (64 MiB default: 67108864)
CACHE_MAX_BYTES=67108864
# MAX_CONCURRENT_UPLOADS: Global server-wide simultaneous upload chunk semaphore
MAX_CONCURRENT_UPLOADS=4
# MAX_CONCURRENT_DOWNLOADS: Global server-wide simultaneous download stream semaphore
MAX_CONCURRENT_DOWNLOADS=4
# MAX_USER_CONCURRENCY: Maximum concurrent chunks per user session
MAX_USER_CONCURRENCY=6
# MAX_MEMORY_BUDGET_BYTES: Admission control heap limit (384 MiB default: 402653184 for 512 MiB RAM container)
MAX_MEMORY_BUDGET_BYTES=402653184
